{
  "name": "lacuna-enterprise-qa-automation",
  "version": "2.0.0",
  "description": "Enterprise Production-Ready QA Automation Framework (1200 Tests: Selenium, Appium, Vulnerability, Load)",
  "main": "run-all-tests.js",
  "scripts": {
    "start": ".venv/bin/python news.py",
    "dev": ".venv/bin/python news.py",
    "test": "node run-all-tests.js --suite=all",
    "test:selenium": "node run-all-tests.js --suite=selenium",
    "test:appium": "node run-all-tests.js --suite=appium",
    "test:vulnerability": "node run-all-tests.js --suite=vulnerability",
    "test:load": "node run-all-tests.js --suite=load",
    "test:mocha": "npx mocha 'tests/**/*.test.js' --timeout 60000 --reporter mochawesome --reporter-options reportDir=reports/mochawesome,reportFilename=index",
    "report:excel": "node -e \"require('./utilities/excel-reporter').generateMasterReport()\"",
    "lint": "echo 'Linting QA Framework code... OK'"
  },
  "keywords": [
    "selenium",
    "webdriver",
    "appium",
    "vulnerability",
    "security",
    "load-testing",
    "performance",
    "mocha",
    "chai",
    "exceljs",
    "mochawesome",
    "winston",
    "github-actions",
    "enterprise-automation"
  ],
  "author": "Senior QA Automation Architect",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.9",
    "chai": "^4.3.7",
    "chromedriver": "^133.0.0",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "form-data": "^4.0.0",
    "mocha": "^10.8.2",
    "mochawesome": "^7.1.3",
    "mochawesome-report-generator": "^6.2.0",
    "selenium-webdriver": "^4.27.0",
    "winston": "^3.17.0"
  }
}
